#!/bin/sh
# falcon-pa setup — run once from your clone: ./bin/setup
# Installs the two launcher commands (claude-pa, codex-pa) pointed at THIS clone,
# and the Claude Code output style + settings that make claude-pa speak plainly.
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: Node.js not found. Install Node >= 22.5 first: https://nodejs.org" >&2
  exit 1
fi
NODE_OK=$(node -e 'const [a,b]=process.versions.node.split(".").map(Number); console.log(a>22||(a===22&&b>=5)?"y":"n")')
if [ "$NODE_OK" != "y" ]; then
  echo "ERROR: Node $(node -v) is too old. The brain needs Node >= 22.5." >&2
  exit 1
fi
command -v claude >/dev/null 2>&1 || command -v codex >/dev/null 2>&1 || \
  echo "WARNING: neither 'claude' nor 'codex' found on PATH — install Claude Code or Codex before starting." >&2

PA_HOME="$(cd "$(dirname "$0")/.." && pwd)"
BIN_DIR="${HOME}/.local/bin"
mkdir -p "$BIN_DIR" "$HOME/.claude/output-styles" "$HOME/.claude/pa"

cp "$PA_HOME/config/pa-speak.md" "$HOME/.claude/output-styles/pa-speak.md"
cp "$PA_HOME/config/pa-settings.json" "$HOME/.claude/pa/settings.json"
chmod +x "$PA_HOME/bin/brain"

cat > "$BIN_DIR/claude-pa" <<EOF
#!/bin/sh
# claude-pa — your business PA on Claude Code (generated by falcon-pa bin/setup).
cd "$PA_HOME" || exit 1
exec claude \\
  --dangerously-skip-permissions \\
  --settings "\$HOME/.claude/pa/settings.json" \\
  "\$@"
EOF

cat > "$BIN_DIR/codex-pa" <<EOF
#!/bin/sh
# codex-pa — your business PA on Codex (generated by falcon-pa bin/setup).
# The plain-speech rules and brain teaching load from AGENTS.md in the PA folder.
cd "$PA_HOME" || exit 1
exec codex --sandbox danger-full-access "\$@"
EOF

chmod +x "$BIN_DIR/claude-pa" "$BIN_DIR/codex-pa"

echo "falcon-pa setup complete."
echo "  PA folder : $PA_HOME"
echo "  Commands  : claude-pa, codex-pa (in $BIN_DIR — make sure it is on your PATH)"
echo "Next: type claude-pa (or codex-pa). On first run the PA installs its brain and"
echo "asks your name and timezone."
